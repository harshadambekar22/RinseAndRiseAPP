# Copy this file to ".env" and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the browser.

# Google OAuth client ID (same value as Google:ClientId in the backend appsettings)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# The pickup-location map uses OpenStreetMap tiles + Nominatim geocoding —
# both free, no API key needed.

# Where the .NET API lives. Leave blank to use the Vite proxy ("/api") in dev.
VITE_API_BASE_URL=
