{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=dryclean.db"
  },
  "Jwt": {
    "Key": "CHANGE_ME_to_a_long_random_secret_at_least_32_chars_long_1234567890",
    "Issuer": "DryCleanApi",
    "Audience": "DryCleanClient",
    "ExpiryMinutes": 1440
  },
  "Google": {
    "ClientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com"
  },
  "Razorpay": {
    "KeyId": "rzp_test_YOUR_KEY_ID",
    "KeySecret": "YOUR_RAZORPAY_KEY_SECRET"
  },
  "Notifications": {
    "Provider": "Console",
    "Twilio": {
      "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
      "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
      "WhatsAppFrom": "whatsapp:+14155238886",
      "SmsFrom": "+1XXXXXXXXXX"
    }
  },
  "Email": {
    "SmtpHost": "YOUR_SMTP_HOST",
    "SmtpPort": "587",
    "SmtpUsername": "YOUR_SMTP_USERNAME",
    "SmtpPassword": "YOUR_SMTP_PASSWORD",
    "SmtpFromEmail": "no-reply@YOUR_DOMAIN.com",
    "SmtpFromName": "Fresh & Fold"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Seed": {
    "AdminEmail": "admin@dryclean.local",
    "AdminPassword": "Admin@123"
  }
}
